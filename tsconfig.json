{
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2023",
    "sourceMap": true,
    "outDir": "./dist",
    "lib": ["es2023"],
    "esModuleInterop": true,
    "strictNullChecks": true,
    "types": ["node", "jest"],
    "resolveJsonModule": true,
    "paths": {
      "client/*": ["./src/client/*"],
      "server/*": ["./src/server/*"],
      "scheduler/*": ["./src/scheduler/*"],
      "shared/*": ["./src/shared/*"],
      "@jest/*": ["./.jest/*"],
      "@forms/*": ["./docker/apply/forms-json/*"]
    },
    "useUnknownInCatchVariables": false
  },
  "include": [
    ".jest/*",
    "cypress.config.ts",
    "prisma.config.ts",
    "docker/apply/forms-json/*",
    "src",
    "src/server/**/*",
    "src/scheduler/**/*",
    "src/client/**/*",
    "node_modules/jest-extended/types/**/*.d.ts"
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "ignore": ["dist"]
}
